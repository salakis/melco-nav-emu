Subject: [PATCH 0007] sh4: FLDI0/FLDI1 load the constant whatever FPSCR.PR is

# melco-nav-emu core patch.
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (c) 2026 melco-nav-emu contributors
# Modifies GPL-licensed QEMU sources; applied by scripts/qemu.sh.

QEMU raises an illegal-instruction exception for FLDI0/FLDI1 when
FPSCR.PR=1.  The SH-4 Software Manual (9.32/9.33) defines both only for
PR=0 and lists "Possible Exceptions: None"; it never names a trap, so
load the single-precision constant into FRn as with PR=0.

--- a/target/sh4/translate.c
+++ b/target/sh4/translate.c
@@ -1719,13 +1719,16 @@
         gen_helper_fsrra_FT(FREG(B11_8), tcg_env, FREG(B11_8));
         break;
     case 0xf08d: /* fldi0 FRn - FPSCR: R[PR] */
+        /*
+         * No PR check.  The SH-4 manual defines FLDI0/FLDI1 only
+         * for PR=0 and lists "Possible Exceptions: None", so load the
+         * single-precision constant as with PR=0.
+         */
         CHECK_FPU_ENABLED
-        CHECK_FPSCR_PR_0
         tcg_gen_movi_i32(FREG(B11_8), 0);
         return;
     case 0xf09d: /* fldi1 FRn - FPSCR: R[PR] */
         CHECK_FPU_ENABLED
-        CHECK_FPSCR_PR_0
         tcg_gen_movi_i32(FREG(B11_8), 0x3f800000);
         return;
     case 0xf0ad: /* fcnvsd FPUL,DRn */
