Subject: [PATCH 0009] sh4: register the CUP28 machine (Volvo VNS)

# melco-nav-emu core patch.
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (c) 2026 melco-nav-emu contributors
# Modifies GPL-licensed QEMU sources; applied by scripts/qemu.sh.

The second board model in this tree (machine/cup28.c, Volvo VNS CUP28):
register the `cup28` machine type alongside `cup2006` so both share the
SH7750R CPU and SH-4 core.

--- a/hw/sh4/Kconfig
+++ b/hw/sh4/Kconfig
@@ -19,6 +19,13 @@
     depends on SH4
     select SH7750
 
+config CUP28
+    bool
+    default y
+    depends on SH4
+    select SH7750
+    select SERIAL_MM
+
 config SH7750
     bool
     select SH_INTC
--- a/hw/sh4/meson.build
+++ b/hw/sh4/meson.build
@@ -5,5 +5,6 @@
 ))
 sh4_ss.add(when: 'CONFIG_R2D', if_true: files('r2d.c'))
 sh4_ss.add(when: 'CONFIG_CUP2006', if_true: files('cup2006.c'))
+sh4_ss.add(when: 'CONFIG_CUP28', if_true: files('cup28.c'))
 
 hw_arch += {'sh4': sh4_ss}
--- a/configs/devices/sh4-softmmu/default.mak
+++ b/configs/devices/sh4-softmmu/default.mak
@@ -8,3 +8,4 @@
 # Boards are selected by default, uncomment to keep out of the build.
 # CONFIG_R2D=n
 # CONFIG_CUP2006=n
+# CONFIG_CUP28=n
