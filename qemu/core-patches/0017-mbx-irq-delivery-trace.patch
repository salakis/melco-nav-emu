+cup2006_mbx_line_in(const char * a0, int a1, unsigned a2, unsigned a3, unsigned a4, int a5, int a6, int a7, int a8, int a9) "cup2006: MBX in why=%s req=%d status=0x%08x enable=0x%08x active=0x%08x cached=%d src{asserted=%d pending=%d en=%d/%d}"
+cup2006_mbx_line_out(const char * a0, int a1, int a2, int a3, int a4, int a5, unsigned a6, int64_t a7) "cup2006: MBX out why=%s toggle=%d src{asserted=%d pending=%d en=%d/%d} pc=0x%08x t=%" PRId64 "ns"
+cup2006_mbx_reg(const char * a0, unsigned a1, unsigned a2, unsigned a3, unsigned a4, unsigned a5, int a6, int a7, unsigned a8, int64_t a9) "cup2006: MBX reg %s off=0x%03x value=0x%08x status=0x%08x enable=0x%08x active=0x%08x src{asserted=%d pending=%d} pc=0x%08x t=%" PRId64 "ns"
+cup2006_mbx_ack(int a0, int a1, int a2, int a3, int a4, int a5, unsigned a6, int64_t a7) "cup2006: MBX INTC2 ack bit=%d src{asserted %d->%d pending %d->%d} toggle=%d pc=0x%08x t=%" PRId64 "ns"
 cup2006_du_mbx_status_x12c_done(unsigned a0, unsigned a1, uint64_t a2) "cup2006: mbx status +0x12c done read pc=0x%08x value=0x%08x n=%" PRIu64 ""
 cup2006_du_dppr(unsigned a0) "cup2006: DU DPPR=0x%08x"
 cup2006_du_graphic_console_active_area(int a0, int a1) "cup2006: DU graphic console 0: %dx%d active area (SH7785-compatible DU scan-out)"
--- a/target/sh4/helper.c
+++ b/target/sh4/helper.c
@@ -71,6 +71,7 @@
     int do_irq = cpu_test_interrupt(cs, CPU_INTERRUPT_HARD);
     int do_exp, irq_vector = cs->exception_index;
     uint64_t last_pc = env->pc;
+    uint32_t sr_in = env->sr;
 
     /* prioritize exceptions over interrupts */
 
@@ -89,6 +90,8 @@
             return false;
         }
         if (do_irq && !env->in_sleep) {
+            sh_intc_trace_mbx_deliver(env->intc_handle, 0, -1, last_pc,
+                                      sr_in, env->spc, env->in_sleep);
             return false; /* masked */
         }
     }
@@ -100,6 +103,8 @@
         irq_vector = sh_intc_get_pending_vector(env->intc_handle,
                                                 (env->sr >> 4) & 0xf);
         if (irq_vector == -1) {
+            sh_intc_trace_mbx_deliver(env->intc_handle, 0, -1, last_pc,
+                                      sr_in, env->spc, env->in_sleep);
             return false; /* masked */
         }
     }
@@ -196,6 +201,8 @@
     if (do_irq) {
         env->intevt = irq_vector;
         env->pc = env->vbr + 0x600;
+        sh_intc_trace_mbx_deliver(env->intc_handle, 1, irq_vector, last_pc,
+                                  sr_in, env->spc, 0);
         qemu_plugin_vcpu_interrupt_cb(cs, last_pc);
         return true;
     }
