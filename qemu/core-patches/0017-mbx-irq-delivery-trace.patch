Subject: [PATCH 0017] sh4: trace MBX interrupt delivery from source to CPU

# melco-nav-emu core patch (diagnostic, trace-only).
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (c) 2026 melco-nav-emu contributors
# Modifies GPL-licensed QEMU sources; applied by scripts/qemu.sh.

The board trace shows the MBX1 model's line and its own register state, but
not the SH INTC source's asserted/pending bookkeeping at that moment, nor
whether the CPU sampled the request before the level fell.  Add trace events,
with no change to behaviour:

  sh_intc_mbx_query    the MBX source's asserted/pending/priority/enabled
                       state at every sh_intc_get_pending_vector() call that
                       sees it pending, including calls that return -1 because
                       IMASK outranks it;
  sh_intc_mbx_deliver  the SR/IMASK/BL decision and the vector the CPU takes
                       (or declines) when the MBX source is pending;
  cup2006_mbx_*        the board's sense/update/ack lines, putting the
                       requested model level, computed active value, cached
                       edge and INTC source state on one timeline.

All are inert unless -trace enables them.  Rate limits bound a masked spin:
32 query samples then every 1024th, and 64 delivery samples then every 4096th.
--- a/hw/intc/trace-events
+++ b/hw/intc/trace-events
@@ -337,6 +337,8 @@
 sh_intc_read(unsigned size, uint64_t offset, unsigned long val) "size %u 0x%" PRIx64 " -> 0x%lx"
 sh_intc_write(unsigned size, uint64_t offset, unsigned long val) "size %u 0x%" PRIx64 " <- 0x%lx"
 sh_intc_set(int id, int enable) "setting interrupt group %d to %d"
+sh_intc_mbx_query(int a0, int a1, int a2, int a3, int a4, int a5, int a6, int a7) "sh_intc: MBX query n=%d imask=%d parent=%d src{asserted=%d pending=%d prio=%d chosen=0x%03x} enabled=%d"
+sh_intc_mbx_deliver(int a0, int a1, unsigned a2, unsigned a3, unsigned a4, unsigned a5, int a6) "sh4: MBX deliver taken=%d vector=0x%03x pc=0x%08x sr=0x%08x spc=0x%08x sleep=%d imask=%d"
 
 # loongson_ipi.c
 loongson_ipi_read(unsigned size, uint64_t addr, uint64_t val) "size: %u addr: 0x%"PRIx64 "val: 0x%"PRIx64
--- a/hw/intc/sh_intc.c
+++ b/hw/intc/sh_intc.c
@@ -85,6 +85,8 @@
     unsigned int i;
     int best = -1;
     int best_prio = -1;
+    int mbx_asserted = 0, mbx_pending = 0, mbx_prio = -1, mbx_enabled = 0;
+    static unsigned mbx_queries;
 
     /* slow: use a linked lists of pending sources instead */
     /*
@@ -96,6 +98,12 @@
     for (i = 0; i < desc->nr_sources; i++) {
         struct intc_source *source = &desc->sources[i];
 
+        if (source->vect == 0x900) {
+            mbx_asserted = source->asserted;
+            mbx_pending = source->pending;
+            mbx_prio = source->prio;
+            mbx_enabled = source->enable_count == source->enable_max;
+        }
         if (!source->pending || !source->vect) {
             continue;
         }
@@ -108,14 +116,66 @@
         }
     }
 
+    /*
+     * Diagnostic: the MBX source's state at every mask decision, including
+     * the ones where it is pending but its priority loses to IMASK and the
+     * function returns -1.  Bounded so a long masked spin cannot flood.
+     */
+    if (mbx_pending || (best >= 0 && desc->sources[best].vect == 0x900)) {
+        if (mbx_queries < 32 || (mbx_queries & 0x3ff) == 0) {
+            trace_sh_intc_mbx_query(mbx_queries, imask, desc->pending,
+                                    mbx_asserted, mbx_pending, mbx_prio,
+                                    best >= 0 ? desc->sources[best].vect : 0,
+                                    mbx_enabled);
+        }
+        mbx_queries++;
+    }
+
     if (best < 0) {
         return -1;
     }
 
     trace_sh_intc_pending(desc->pending, desc->sources[best].vect);
     return desc->sources[best].vect;
+}
+
+/*
+ * Diagnostic probes for the INTEVT 0x900 line's CPU side.  Trace-only: the
+ * helpers report state and change nothing.
+ */
+bool sh_intc_source_pending(struct intc_desc *desc, unsigned short vect)
+{
+    unsigned int i;
+
+    if (!desc) {
+        return false;
+    }
+    for (i = 0; i < desc->nr_sources; i++) {
+        if (desc->sources[i].vect == vect && desc->sources[i].pending) {
+            return true;
+        }
+    }
+    return false;
 }
 
+void sh_intc_trace_mbx_deliver(struct intc_desc *desc, int taken, int vector,
+                               uint32_t pc, uint32_t sr, uint32_t spc,
+                               int in_sleep)
+{
+    static unsigned mbx_attempts;
+
+    if (vector != 0x900 && !sh_intc_source_pending(desc, 0x900)) {
+        return;
+    }
+    if (mbx_attempts >= 64 && (mbx_attempts & 0xfff) != 0) {
+        mbx_attempts++;
+        return;
+    }
+    mbx_attempts++;
+    trace_sh_intc_mbx_deliver(taken, vector < 0 ? 0 : vector, pc, sr, spc,
+                              in_sleep, (sr >> 4) & 0xf);
+}
+
 typedef enum {
     INTC_MODE_NONE,
     INTC_MODE_DUAL_SET,
--- a/include/hw/sh4/sh_intc.h
+++ b/include/hw/sh4/sh_intc.h
@@ -60,6 +60,12 @@
 
 int sh_intc_get_pending_vector(struct intc_desc *desc, int imask);
 
+/* Diagnostics: read-only state probes, no behaviour. */
+bool sh_intc_source_pending(struct intc_desc *desc, unsigned short vect);
+void sh_intc_trace_mbx_deliver(struct intc_desc *desc, int taken, int vector,
+                               uint32_t pc, uint32_t sr, uint32_t spc,
+                               int in_sleep);
+
 void sh_intc_toggle_source(struct intc_source *source,
                            int enable_adj, int assert_adj);
 
