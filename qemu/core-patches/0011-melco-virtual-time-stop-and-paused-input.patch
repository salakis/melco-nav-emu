+/*
+ * melco-nav-emu: set by the machine's x-stop-at-ns property.  A VM paused
+ * at a virtual-clock deadline then accepts input, so a harness can deliver
+ * a key at an exact virtual time; otherwise input to a stopped VM is
+ * dropped as upstream does.
+ */
+bool qemu_input_accept_while_paused;
+
+static bool qemu_input_runstate_ok(void)
+{
+    return runstate_is_running() || runstate_check(RUN_STATE_SUSPENDED) ||
+           (qemu_input_accept_while_paused &&
+            runstate_check(RUN_STATE_PAUSED));
+}
