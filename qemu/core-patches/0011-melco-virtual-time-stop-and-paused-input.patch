+/*
+ * melco-nav-emu: deterministic harness hooks (not guest-visible).
+ * x-vclock-ns reads QEMU_CLOCK_VIRTUAL.  Writing x-stop-at-ns arms a
+ * virtual-clock timer that pauses the VM (RUN_STATE_PAUSED, a QMP STOP
+ * event) when the virtual clock reaches that time; a negative value
+ * disarms it.  With -icount and sleep=off the pause lands on the same
+ * instruction every run, so screendumps and keys sent while paused (input
+ * is accepted then, see ui/input.c) happen at the same guest state.
+ */
+static QEMUTimer *machine_x_stop_timer;
+
+static void machine_x_stop_cb(void *opaque)
+{
+    CPUState *cpu;
+
+    /*
+     * Stop every vCPU here, under the BQL.  With icount this callback
+     * usually runs in the vCPU thread between TBs, where current_cpu is
+     * NULL, so vm_stop()'s cpu_stop_current() would leave the vCPU running
+     * until the main loop's pause_all_vcpus().  And until that main-loop
+     * step sets the run state, the stopped vCPU counts as idle, so with
+     * sleep=off icount_start_warp_timer() would jump the clock to the next
+     * device deadline and let the main loop run device timers: both are
+     * host-time races.  The warp stays inhibited until the VM runs again.
+     */
+    icount_warp_inhibit = true;
+    CPU_FOREACH(cpu) {
+        cpu->stop = true;
+        cpu_exit(cpu);
+    }
+    vm_stop(RUN_STATE_PAUSED);
+}
+
+static void machine_x_stop_vmstate(void *opaque, bool running,
+                                   RunState state)
+{
+    if (running) {
+        icount_warp_inhibit = false;
+    }
+}
+
+static void machine_get_x_vclock_ns(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    int64_t ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    visit_type_int64(v, name, &ns, errp);
+}
+
+static void machine_get_x_stop_at_ns(Object *obj, Visitor *v,
+                                     const char *name, void *opaque,
+                                     Error **errp)
+{
+    int64_t ns = machine_x_stop_timer ?
+                 timer_expire_time_ns(machine_x_stop_timer) : -1;
+
+    visit_type_int64(v, name, &ns, errp);
+}
+
+static void machine_set_x_stop_at_ns(Object *obj, Visitor *v,
+                                     const char *name, void *opaque,
+                                     Error **errp)
+{
+    int64_t ns;
+
+    if (!visit_type_int64(v, name, &ns, errp)) {
+        return;
+    }
+    if (!machine_x_stop_timer) {
+        machine_x_stop_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                            machine_x_stop_cb, NULL);
+    }
+    if (!qemu_input_accept_while_paused) {
+        qemu_add_vm_change_state_handler(machine_x_stop_vmstate, NULL);
+    }
+    qemu_input_accept_while_paused = true;
+    if (ns < 0) {
+        timer_del(machine_x_stop_timer);
+    } else {
+        timer_mod(machine_x_stop_timer, ns);
+    }
+}
+
 static void machine_class_init(ObjectClass *oc, const void *data)
 {
     MachineClass *mc = MACHINE_CLASS(oc);
@@ -1135,6 +1222,17 @@
         machine_get_dt_compatible, machine_set_dt_compatible);
     object_class_property_set_description(oc, "dt-compatible",
         "Overrides the \"compatible\" property of the dt root node");
+
+    object_class_property_add(oc, "x-vclock-ns", "int",
+        machine_get_x_vclock_ns, NULL, NULL, NULL);
+    object_class_property_set_description(oc, "x-vclock-ns",
+        "Current QEMU_CLOCK_VIRTUAL time in ns (read-only, for harnesses)");
+
+    object_class_property_add(oc, "x-stop-at-ns", "int",
+        machine_get_x_stop_at_ns, machine_set_x_stop_at_ns, NULL, NULL);
+    object_class_property_set_description(oc, "x-stop-at-ns",
+        "Pause the VM when QEMU_CLOCK_VIRTUAL reaches this time (ns); "
+        "negative disarms (for harnesses)");
 
     object_class_property_add_bool(oc, "dump-guest-core",
         machine_get_dump_guest_core, machine_set_dump_guest_core);
